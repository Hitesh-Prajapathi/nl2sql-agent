# Copy to .env and fill in real values. Never commit .env.
# Field names map 1:1 to src/nl2sql/config.py (pydantic-settings, case-insensitive).

# ─── Database ────────────────────────────────────────────────────────────────
# Used by the agent when running on the host (make dev / make cli / make test).
# Points at the Postgres container published on localhost:5432.
DATABASE_URL=postgresql://nl2sql_reader:reader_pass@localhost:5432/nl2sql_assignment

# Admin DSN, used only for initial setup (role creation, schema load).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/nl2sql_assignment

# Optional overrides for `docker compose`. Compose reads them for interpolation
# and does not touch DATABASE_URL, so the in-network host "postgres" is kept
# inside the app container. Leave unset to use the defaults in docker-compose.yml.
# COMPOSE_DATABASE_URL=postgresql://nl2sql_reader:reader_pass@postgres:5432/nl2sql_assignment
# COMPOSE_DATABASE_ADMIN_URL=postgresql://postgres:postgres@postgres:5432/nl2sql_assignment

# ─── LLM provider ────────────────────────────────────────────────────────────
# groq  = call the Groq API (needs GROQ_API_KEY)
# fake  = deterministic offline provider for tests and CI
LLM_PROVIDER=groq

# ─── Groq ────────────────────────────────────────────────────────────────────
# Placeholder. Get a key from the Groq console. Required when LLM_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here

# ─── Models (Groq model IDs) ─────────────────────────────────────────────────
# Groq free tier on this key: every model is limited to 1,000 requests/day and
# 8,000 tokens/minute. Check the Groq console for the models currently offered.
# Main planner / SQL generation model.
PLANNER_MODEL=openai/gpt-oss-120b
# Answer synthesis model.
FAST_MODEL=openai/gpt-oss-20b
# Used when the planner/fast model keeps failing with a retryable error (429, 5xx, timeout).
FALLBACK_MODEL=openai/gpt-oss-20b
# gpt-oss reasoning effort: low | medium | high (reasoning tokens count against the output cap).
LLM_REASONING_EFFORT=low

# ─── Langfuse (optional tracing) ─────────────────────────────────────────────
# Tracing is enabled only when both keys are non-empty. Leave them blank to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Use the region that matches your Langfuse project, e.g. https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Agent behaviour ─────────────────────────────────────────────────────────
# Maximum SQL repair attempts per question.
MAX_RETRY_ATTEMPTS=3
# Maximum rows fetched per query (applied in db/executor.py).
QUERY_ROW_CAP=500
# Server-side statement timeout for each query, in milliseconds.
STATEMENT_TIMEOUT_MS=15000
# Lock wait timeout for each query, in milliseconds.
LOCK_TIMEOUT_MS=5000
# Intended schema-cache TTL in seconds. Currently not read by the code.
SCHEMA_CACHE_TTL_SECONDS=300

# ─── App ─────────────────────────────────────────────────────────────────────
# Intended log level. Currently defined in config.py but not read by the code.
LOG_LEVEL=INFO
# Reported by GET /health and the OpenAPI docs.
AGENT_VERSION=1.0.0

# ─── Phase 5: API hardening ──────────────────────────────────────────────────
# "key_id:sha256hex" pairs, comma-separated. Empty disables auth.
# Generate: python -c "import hashlib;print(hashlib.sha256(b'SECRET').hexdigest())"
API_KEY_HASHES=
API_KEY_HEADER=X-API-Key
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_QUESTION_CHARS=2000
RATE_LIMIT_PER_KEY_PER_MIN=60
RATE_LIMIT_PER_IP_PER_MIN=120
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=20
SESSION_MAX_BYTES=65536
SESSION_MAX_SESSIONS=1000

# ─── LLM resilience ──────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Process-wide cap on in-flight LLM calls. The load test showed 8 was the bottleneck and 64 gave
# the best numbers; 32 is the safer choice on the Groq free tier (8,000 tokens/minute).
LLM_MAX_CONCURRENCY=32
LLM_BREAKER_FAILURE_THRESHOLD=5
LLM_BREAKER_RESET_SECONDS=30

# ─── Kill switch ─────────────────────────────────────────────────────────────
LLM_KILL_SWITCH=false

# ─── Audit log (db/audit.sql creates the role and schema) ────────────────────
AUDIT_ENABLED=true
AUDIT_DATABASE_URL=postgresql://audit_writer:writer_pass@localhost:5432/nl2sql_assignment

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nl2sql-agent

# ─── Sessions / multi-worker ─────────────────────────────────────────────────
# memory (default, one worker) | postgres | redis. Use postgres or redis with --workers > 1.
# SESSION_BACKEND=postgres
# SESSION_DATABASE_URL=postgresql://app_state_writer:app_state_pass@localhost:5432/nl2sql_assignment
# SESSION_REDIS_URL=redis://localhost:6379/0
# Prometheus multiprocess mode (required with --workers > 1; empty dir, wiped on each start):
# PROMETHEUS_MULTIPROC_DIR=/tmp/nl2sql_prom
