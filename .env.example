# ─── Database ───────────────────────────────────────────────────────────────
# Connection string for the nl2sql_assignment database
# For Docker setup: postgresql://nl2sql_reader:reader_pass@localhost:5432/nl2sql_assignment
DATABASE_URL=postgresql://nl2sql_reader:reader_pass@localhost:5432/nl2sql_assignment

# Admin URL used ONLY for initial setup (creating role, running schema)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/nl2sql_assignment

# ─── Groq API ────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── Models ──────────────────────────────────────────────────────────────────
PLANNER_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
FALLBACK_MODEL=llama-4-scout-17b

# ─── Langfuse ────────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
QUERY_ROW_CAP=500
STATEMENT_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=5000
SCHEMA_CACHE_TTL_SECONDS=300

# ─── App ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AGENT_VERSION=1.0.0
